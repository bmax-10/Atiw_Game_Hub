# Neon PostgreSQL – niemals die echte Datei .env.local committen.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth – eigener langer Zufallswert.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Nur auf dem Server verwendetes Secret für kurzlebige Score-Sessions.
# Dieser Wert darf niemals in einem Browser-Game oder NEXT_PUBLIC_-Wert landen.
GAME_SCORE_SECRET="replace-with-a-different-long-random-secret"
